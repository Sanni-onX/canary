{
  "name": "contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Foundry project for the QoreChain EVM, with a helper that opens the EVM authorisation window.",
  "scripts": {
    "forge-std": "node ../scripts/forge.mjs install foundry-rs/forge-std@v1.9.7 --no-git",
    "build": "node ../scripts/forge.mjs build",
    "test": "node ../scripts/forge.mjs test",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "node ../scripts/forge.mjs script script/DiscoveryProbe.s.sol --rpc-url qorechain_testnet --broadcast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
